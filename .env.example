# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=True

# 大模型配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-3.5-turbo-1106
MAX_TOKENS=4000
TEMPERATURE=0.1

# 爬虫配置
CRAWL_RATE_LIMIT=1.0  # 请求间隔（秒）
CRAWL_MAX_RETRIES=3
PROXY_URL=  # 可选代理配置

# 数据库配置
DATABASE_URL=sqlite:///./paper_system.db
CHROMA_DB_PATH=./chroma_db
CHROMA_DB_HOST=  # 远程Chroma服务主机（可选）
CHROMA_DB_PORT=  # 远程Chroma服务端口（可选）
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# 复现环境配置
DOCKER_SOCKET=unix:///var/run/docker.sock
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2.0
SANDBOX_TIMEOUT=300  # 5分钟超时

# 存储配置
STORAGE_PATH=./storage
PDF_STORAGE_PATH=./storage/pdfs
SCRIPT_STORAGE_PATH=./storage/scripts
REPORT_STORAGE_PATH=./storage/reports
