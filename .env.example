# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=False  # 生产环境务必为False，开启后会暴露/docs并启用热重载

# 安全配置
API_KEY=  # 设置后所有/api接口需在请求头X-API-Key携带该密钥；为空则不鉴权（仅本地开发）
CORS_ORIGINS=["http://localhost:8000"]  # 允许的跨域来源白名单，勿使用"*"
ENABLE_STORAGE_STATIC=False  # 是否通过/storage暴露存储目录（含数据库/PDF等敏感文件）

# 数据库凭证（供docker-compose使用）
POSTGRES_DB=paper_system
POSTGRES_USER=paper_user
POSTGRES_PASSWORD=  # 必填，请使用强随机密码

# 大模型配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-3.5-turbo-1106
MAX_TOKENS=4000
TEMPERATURE=0.1

# 爬虫配置
CRAWL_RATE_LIMIT=1.0  # 请求间隔（秒）
CRAWL_MAX_RETRIES=3
PROXY_URL=  # 可选代理配置

# 数据库配置
DATABASE_URL=sqlite:///./paper_system.db
CHROMA_DB_PATH=./chroma_db
CHROMA_DB_HOST=  # 远程Chroma服务主机（可选）
CHROMA_DB_PORT=  # 远程Chroma服务端口（可选）
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# 复现环境配置
DOCKER_SOCKET=unix:///var/run/docker.sock
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2.0
SANDBOX_TIMEOUT=300  # 5分钟超时

# 存储配置
STORAGE_PATH=./storage
PDF_STORAGE_PATH=./storage/pdfs
SCRIPT_STORAGE_PATH=./storage/scripts
REPORT_STORAGE_PATH=./storage/reports
